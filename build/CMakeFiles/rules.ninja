#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = C:\Prusa-Firmware\.dependencies\cmake-3.22.5\bin\cmake.exe --regenerate-during-build -SC:\Prusa-Firmware -BC:\Prusa-Firmware\build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = c:\Prusa-Firmware\.dependencies\ninja-1.12.1\ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = c:\Prusa-Firmware\.dependencies\ninja-1.12.1\ninja -t targets
  description = All primary targets available:

