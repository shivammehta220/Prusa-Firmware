  command = cmd.exe /C "$PRE_LINK && C:\Prusa-Firmware\.dependencies\avr-gcc-7.3.0\bin\avr-g++.exe $FLAGS $LINK_FLAGS @$RSP_FILE -o $TARGET_FILE  && $POST_BUILD"
  description = Linking CXX executable $TARGET_FILE
  rspfile = $RSP_FILE
  rspfile_content = $in $LINK_PATH $LINK_LIBRARIES
  restat = $RESTAT


#############################################
# Rule for compiling C files.

rule C_COMPILER__MK3S_ENGLISH_Release
  depfile = $DEP_FILE
  deps = gcc
  command = C:\Prusa-Firmware\.dependencies\avr-gcc-7.3.0\bin\avr-gcc.exe $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building C object $out


#############################################
