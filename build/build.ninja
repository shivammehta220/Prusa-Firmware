  COMMAND = cmd.exe /C "cd /D C:\Prusa-Firmware\build\build_gen\MK3S && C:\Python312\python.exe C:/Prusa-Firmware/lang/lang-check.py --errors-only --map lang/MK3S_lang.map C:/Prusa-Firmware/lang/po/Firmware_ro.po && C:\Python312\python.exe C:/Prusa-Firmware/lang/lang-build.py lang/MK3S_lang.map C:/Prusa-Firmware/lang/po/Firmware_ro.po lang/MK3S_ro.bin && C:\Prusa-Firmware\.dependencies\cmake-3.22.5\bin\cmake.exe -DLANG_MAX_SIZE=13568 -DLANG_FILE=lang/MK3S_ro.bin -P C:/Prusa-Firmware/cmake/Check_lang_size.cmake"
  DESC = Generating MK3S_ro.bin
  restat = 1


